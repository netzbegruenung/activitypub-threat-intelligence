# apti-statsd image: copies the released binary (no Rust toolchain, no registry).
# Build: docker compose build   (APTI_VERSION from .env, e.g. v2026.10.9)
ARG DEBIAN_TAG=bookworm-slim

FROM debian:${DEBIAN_TAG} AS fetch
ARG APTI_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /dl
RUN test -n "$APTI_VERSION" || { echo "set APTI_VERSION (e.g. v2026.10.9)" >&2; exit 1; }
RUN base="https://github.com/netzbegruenung/activitypub-threat-intelligence/releases/download/${APTI_VERSION}" \
 && for f in SHA256SUMS apti-statsd-${APTI_VERSION}-linux-x86_64; do \
     curl -fsSLO "$base/$f"; done \
 && grep -E " apti-statsd-${APTI_VERSION}-linux-x86_64\$" SHA256SUMS | sha256sum -c - \
 && install -m 0755 apti-statsd-${APTI_VERSION}-linux-x86_64 /apti-statsd

FROM debian:${DEBIAN_TAG}
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --shell /usr/sbin/nologin apti-statsd \
 && install -d -o apti-statsd -g apti-statsd -m 0755 /var/lib/apti-statsd/public
COPY --from=fetch /apti-statsd /usr/local/bin/
USER apti-statsd
# The rendered page and node directory; served by the web server.
VOLUME ["/var/lib/apti-statsd/public"]
ENTRYPOINT ["tini", "--", "apti-statsd"]
CMD ["--config", "/etc/apti-statsd/config.toml"]
