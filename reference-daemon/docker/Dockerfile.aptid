# aptid image: copies the released binaries (no Rust toolchain, no registry).
# Build: docker compose build   (APTI_VERSION from .env, e.g. v2026.10.9)
ARG DEBIAN_TAG=bookworm-slim

FROM debian:${DEBIAN_TAG} AS fetch
ARG APTI_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /dl
RUN test -n "$APTI_VERSION" || { echo "set APTI_VERSION (e.g. v2026.10.9)" >&2; exit 1; }
RUN base="https://github.com/netzbegruenung/activitypub-threat-intelligence/releases/download/${APTI_VERSION}" \
 && for f in SHA256SUMS aptid-${APTI_VERSION}-linux-x86_64 apti-tui-${APTI_VERSION}-linux-x86_64; do \
      curl -fsSLO "$base/$f"; done \
 && grep -E " (aptid|apti-tui)-${APTI_VERSION}-linux-x86_64\$" SHA256SUMS | sha256sum -c - \
 && install -m 0755 aptid-${APTI_VERSION}-linux-x86_64 /aptid \
 && install -m 0755 apti-tui-${APTI_VERSION}-linux-x86_64 /apti-tui

FROM debian:${DEBIAN_TAG}
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home-dir /var/lib/aptid --shell /usr/sbin/nologin aptid \
 && install -d -o aptid -g aptid -m 0750 /var/lib/aptid /run/aptid
COPY --from=fetch /aptid /apti-tui /usr/local/bin/
USER aptid
VOLUME ["/var/lib/aptid", "/run/aptid"]
EXPOSE 8080 8081
ENTRYPOINT ["tini", "--", "aptid"]
CMD ["--config", "/etc/aptid/config.toml"]
