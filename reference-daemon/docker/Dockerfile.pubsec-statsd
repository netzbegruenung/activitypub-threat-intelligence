# pubsec-statsd image: copies the released binary (no Rust toolchain, no registry).
# Build: docker compose build   (PUBSEC_VERSION from .env, e.g. v2026.10.9)
ARG DEBIAN_TAG=trixie-slim

FROM debian:${DEBIAN_TAG} AS fetch
ARG PUBSEC_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /dl
RUN test -n "$PUBSEC_VERSION" || { echo "set PUBSEC_VERSION (e.g. v2026.10.9)" >&2; exit 1; }
RUN base="https://github.com/netzbegruenung/activitypub-threat-intelligence/releases/download/${PUBSEC_VERSION}" \
 && for f in SHA256SUMS pubsec-statsd-${PUBSEC_VERSION}-linux-x86_64; do \
     curl -fsSLO "$base/$f"; done \
 && grep -E " pubsec-statsd-${PUBSEC_VERSION}-linux-x86_64\$" SHA256SUMS | sha256sum -c - \
 && install -m 0755 pubsec-statsd-${PUBSEC_VERSION}-linux-x86_64 /pubsec-statsd

FROM debian:${DEBIAN_TAG}
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --shell /usr/sbin/nologin pubsec-statsd \
 && install -d -o pubsec-statsd -g pubsec-statsd -m 0755 /var/lib/pubsec-statsd/public
COPY --from=fetch /pubsec-statsd /usr/local/bin/
USER pubsec-statsd
# The rendered page and node directory; served by the web server.
VOLUME ["/var/lib/pubsec-statsd/public"]
ENTRYPOINT ["tini", "--", "pubsec-statsd"]
CMD ["--config", "/etc/pubsec-statsd/config.toml"]
