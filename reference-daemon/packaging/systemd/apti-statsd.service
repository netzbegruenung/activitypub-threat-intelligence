[Unit]
Description=AP-TI public statistics page
Documentation=https://github.com/netzbegruenung/activitypub-threat-intelligence
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apti-statsd
Group=apti-statsd
ExecStart=/usr/bin/apti-statsd --config /etc/apti-statsd/config.toml run
Restart=on-failure
RestartSec=5
StateDirectory=apti-statsd
StateDirectoryMode=0755
CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
