[Unit]
Description=AP-TI reference daemon
Documentation=https://github.com/netzbegruenung/activitypub-threat-intelligence
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aptid
Group=aptid
ExecStart=/usr/bin/aptid --config /etc/aptid/config.toml
Restart=on-failure
RestartSec=5
StateDirectory=aptid
StateDirectoryMode=0750
RuntimeDirectory=aptid
RuntimeDirectoryMode=0750
CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
